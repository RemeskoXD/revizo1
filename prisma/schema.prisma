generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                   @id @default(cuid())
  name                         String?
  email                        String?                  @unique
  password                     String?
  phone                        String?
  bankAccount                  String?
  creditBalance                Float                    @default(0)
  role                         String                   @default("CUSTOMER")
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  companyId                    String?
  emailVerified                DateTime?
  priority                     Int                      @default(0)
  commissionRate               Float?                   @default(100)
  inviteCode                   String?                  @unique
  isDeleted                    Boolean                  @default(false)
  stripeCustomerId             String?                  @unique
  accountStatus                String                   @default("ACTIVE")
  address                      String?                  @db.VarChar(500)
  /// Když je nastaveno, uživatel se nemůže přihlásit a aktivní relace je ukončena.
  bannedAt                     DateTime?
  emailNotifications           Boolean                  @default(true)
  expectedTechnicians          Int?
  ico                          String?                  @db.VarChar(20)
  lastStripePaymentAt          DateTime?
  licenseDocument              String?                  @db.LongText
  licenseMimeType              String?                  @db.VarChar(120)
  licenseValidUntil            DateTime?
  pendingCompanyInviteCode     String?                  @db.VarChar(80)
  /// Po registraci (zákazník) nebo po schválení adminem (technik/firma): dokončit první roční úhradu v aplikaci.
  requiresSubscriptionCheckout Boolean                  @default(false)
  /// Platnost oprávnění vykonávat revize (technik / firma); nastavuje administrátor při schválení nebo později.
  revisionAuthValidUntil       DateTime?
  /// Počet objektů v základu (CUSTOMER 1, SVJ 3, COMPANY_ADMIN 3). Zdroj pravdy: docs/pricing-rules.md.
  /// Default 0 = doplníme z role helperem `getObjectLimit()`. Lze přepsat v administraci.
  objectLimitBase              Int                      @default(0)
  /// CUSTOMER: počet zaplacených dalších objektů á 100 Kč/rok (přičítá se k objectLimitBase).
  objectLimitExtraPaid         Int                      @default(0)
  /// SVJ / COMPANY_ADMIN: TRUE = aktivní balíček do 10 objektů za 600 Kč/rok.
  objectPackagePaid            Boolean                  @default(false)
  /// Individuální nabídka (SVJ/COMPANY_ADMIN nad 10 objektů). Pokud != null, má přednost před vším výše.
  objectLimitOverride          Int?
  /// COMPANY_ADMIN: TRUE = aktivní měsíční Stripe subscription pro billing techniků (200 Kč × billable seats).
  companyTechBillingActive     Boolean                  @default(false)
  /// Stripe Subscription ID pro billing techniků (umožní rychle najít subscription při sync).
  companyTechSubscriptionId    String?                  @db.VarChar(120)
  /// REALTY/PRODUCT_MANAGER: ID makléře, který přivedl tohoto uživatele (typicky CUSTOMER) přes ?ref=<inviteCode>.
  referredByRealtorId          String?                  @db.VarChar(60)
  referredByRealtor            User?                    @relation("RealtorReferrals", fields: [referredByRealtorId], references: [id], onDelete: SetNull)
  referrals                    User[]                   @relation("RealtorReferrals")
  /// Reference na odměny získané jako makléř.
  realtorRewards               ReferralReward[]         @relation("RealtorRewards")
  /// Reference na odměny vyplacené za uživatele (jako referenced customer).
  customerRewards              ReferralReward[]         @relation("CustomerRewards")
  /// Hlídané firemní dokumenty (svářečské průkazy, …)
  companyDocuments             CompanyDocument[]        @relation("CompanyDocumentsOwner")
  /// Poplatky makléře za převody nemovitostí (200 Kč)
  realtorTransferFees          RealtorTransferFee[]     @relation("RealtorTransferFees")
  /// Poplatky vázané na přijaté nemovitosti (jako customer)
  transferFeesAsCustomer       RealtorTransferFee[]     @relation("TransferFeeCustomers")
  accountDeletionRequests      AccountDeletionRequest[]
  activityLogs                 ActivityLog[]
  receivedJoinRequests         CompanyJoinRequest[]     @relation("CompanyRequests")
  sentJoinRequests             CompanyJoinRequest[]     @relation("TechnicianRequests")
  defectTasks                  DefectTask[]
  receivedTransfers            DocumentTransfer[]       @relation("Receiver")
  sentTransfers                DocumentTransfer[]       @relation("Sender")
  messages                     Message[]                @relation("UserMessages")
  notifications                Notification[]
  companyOrders                Order[]                  @relation("CompanyOrders")
  orders                       Order[]                  @relation("CustomerOrders")
  assignedOrders               Order[]                  @relation("TechnicianOrders")
  claimedProperties            Property[]               @relation("PropertyClaimer")
  properties                   Property[]               @relation("PropertyOwner")
  payoutRequests               PayoutRequest[]
  supportTickets               SupportTicket[]          @relation("UserSupportTickets")
  supportMessages              SupportTicketMessage[]   @relation("UserSupportMessages")
  pushDevices                  PushDevice[]
  customerReviews              Review[]                 @relation("CustomerReviews")
  technicianReviews            Review[]                 @relation("TechnicianReviews")
  roleRequests                 RoleRequest[]
  /// Jaké druhy revizí může technik provádět.
  authorizedCategories         RevisionCategory[]       @relation("AuthorizedCategories")
  company                      User?                    @relation("CompanyTechnicians", fields: [companyId], references: [id])
  technicians                  User[]                   @relation("CompanyTechnicians")

  @@index([companyId], map: "User_companyId_fkey")
  @@index([referredByRealtorId])
}

/// Hlídané dokumenty firmy (svářečské průkazy, zdravotní prohlídky, certifikace, …).
/// Viz docs/business-decisions.md sekce 3.1.
model CompanyDocument {
  id            String    @id @default(cuid())
  ownerId       String
  title         String    @db.VarChar(255)
  category      String?   @db.VarChar(80)
  fileBase64    String?   @db.LongText
  fileMimeType  String?   @db.VarChar(120)
  fileName      String?   @db.VarChar(255)
  validUntil    DateTime?
  /// Volitelná poznámka / popis
  notes         String?   @db.Text
  /// Volitelná osoba, ke které se dokument vztahuje (technik, zaměstnanec, …)
  subjectName   String?   @db.VarChar(160)
  /// Volitelný odkaz na uživatele (např. konkrétního technika v týmu)
  subjectUserId String?   @db.VarChar(60)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  owner         User      @relation("CompanyDocumentsOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, validUntil])
  @@index([subjectUserId])
}

/// Odměna makléři za úspěšně zaregistrovaného zákazníka (referral program).
/// Viz docs/pricing-rules.md sekce 4b: 20 Kč zpět makléři po první úhradě CUSTOMER.
model ReferralReward {
  id         String    @id @default(cuid())
  realtorId  String
  customerId String
  amountCzk  Int       @default(20)
  status     String    @default("PENDING")
  /// Zdroj odměny: REF_LINK = registrace přes ?ref=; PROPERTY_TRANSFER = převod nemovitosti přes invite kód;
  /// MANUAL = vytvořeno administrátorem.
  source     String    @default("REF_LINK") @db.VarChar(40)
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  notes      String?   @db.Text
  realtor    User      @relation("RealtorRewards", fields: [realtorId], references: [id], onDelete: Cascade)
  customer   User      @relation("CustomerRewards", fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([realtorId, customerId, source])
  @@index([realtorId, status])
  @@index([customerId])
  @@index([status])
  @@index([source])
}

/// Poplatek makléři za převod nemovitosti přes invite kód (200 Kč).
/// Viz docs/business-decisions.md sekce 2.4. Status: PENDING → PAID → CANCELLED.
model RealtorTransferFee {
  id              String    @id @default(cuid())
  realtorId       String
  customerId      String
  propertyId      String
  amountCzk       Int       @default(200)
  status          String    @default("PENDING")
  /// Stripe Invoice / PaymentIntent ID (po úhradě)
  stripeInvoiceId String?   @db.VarChar(120)
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  notes           String?   @db.Text
  realtor         User      @relation("RealtorTransferFees", fields: [realtorId], references: [id], onDelete: Cascade)
  customer        User      @relation("TransferFeeCustomers", fields: [customerId], references: [id], onDelete: Cascade)
  property        Property  @relation("PropertyTransferFees", fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId])
  @@index([realtorId, status])
  @@index([customerId])
}

/// FCM / push token z mobilní aplikace – uloženo ve stejné DB jako Revizone (DATABASE_URL).
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountDeletionRequest {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("PENDING")
  note          String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  processedAt   DateTime?
  processedById String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RoleRequest {
  id            String   @id @default(cuid())
  userId        String
  requestedRole String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "RoleRequest_userId_fkey")
}

model CompanyJoinRequest {
  id           String   @id @default(cuid())
  technicianId String
  companyId    String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      User     @relation("CompanyRequests", fields: [companyId], references: [id], onDelete: Cascade)
  technician   User     @relation("TechnicianRequests", fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, companyId])
  @@index([companyId], map: "CompanyJoinRequest_companyId_fkey")
}

model DocumentTransfer {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  documentId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])

  @@index([receiverId], map: "DocumentTransfer_receiverId_fkey")
  @@index([senderId], map: "DocumentTransfer_senderId_fkey")
}

model Order {
  id                  String    @id @default(cuid())
  readableId          String    @unique
  serviceType         String
  propertyType        String
  address             String
  notes               String?
  status              String    @default("PENDING")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  customerId          String
  technicianId        String?
  assignedAt          DateTime?
  companyId           String?
  isPublic            Boolean   @default(false)
  reportFile          String?   @db.LongText
  invoiceFile         String?   @db.LongText
  invoiceDueDate      DateTime?
  price               Float?
  preferredDate       DateTime?
  propertyId          String?
  isDeleted           Boolean   @default(false)
  revisionCategoryId  String?
  scheduledDate       DateTime?
  scheduledNote       String?   @db.Text
  confirmedAddress    String?
  revisionResult      String?
  revisionNotes       String?   @db.Text
  nextRevisionDate    DateTime?
  completedAt         DateTime?
  cancelToken         String?   @unique
  /// Zákazník zvolil urgentní termín (+ příplatek dle ceníku, typicky URGENT_SURCHARGE).
  isUrgent            Boolean   @default(false)
  lastExpiryEmailDays Int?
  isPaid              Boolean   @default(false)
  /// Admin verified the revision and payment, ready to payout
  isVerifiedAdmin     Boolean   @default(false)
  servicePackageId    String?

  checklists       ChecklistItem[]
  defectTasks      DefectTask[]
  messages         Message[]
  company          User?              @relation("CompanyOrders", fields: [companyId], references: [id])
  customer         User               @relation("CustomerOrders", fields: [customerId], references: [id])
  property         Property?          @relation(fields: [propertyId], references: [id])
  revisionCategory RevisionCategory?  @relation(fields: [revisionCategoryId], references: [id])
  technician       User?              @relation("TechnicianOrders", fields: [technicianId], references: [id])
  photos           OrderPhoto[]
  review           Review?
  pricingItems     OrderPricingItem[]
  servicePackage   ServicePackage?    @relation(fields: [servicePackageId], references: [id])
  PayoutRequest    PayoutRequest[]

  @@index([companyId], map: "Order_companyId_fkey")
  @@index([customerId], map: "Order_customerId_fkey")
  @@index([propertyId], map: "Order_propertyId_fkey")
  @@index([revisionCategoryId], map: "Order_revisionCategoryId_fkey")
  @@index([technicianId], map: "Order_technicianId_fkey")
}

model ServicePackage {
  id                  String  @id @default(cuid())
  name                String
  description         String? @db.Text
  approximatePrice    Float?
  isVisibleRodinnyDum Boolean @default(true)
  isVisibleSVJ        Boolean @default(true)
  orderIndex          Int     @default(0)
  isActive            Boolean @default(true)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingItem {
  id       String @id @default(cuid())
  code     String @unique
  category String
  name     String
  priceCzk Float
  unit     String /// pausal, ks, km, hodina

  orderItems OrderPricingItem[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model OrderPricingItem {
  id            String @id @default(cuid())
  orderId       String
  pricingItemId String
  quantity      Float  @default(1)
  unitPriceCzk  Float /// snapshot of the price at the time of creation
  totalPriceCzk Float

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pricingItem PricingItem @relation(fields: [pricingItemId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId])
  @@index([pricingItemId])
}

model RevisionCategory {
  id              String   @id @default(cuid())
  name            String   @unique
  group           String
  intervalMonths  Int
  legalBasis      String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Cílové role (CSV: "CUSTOMER,SVJ,COMPANY_ADMIN"). NULL nebo prázdné = pro všechny.
  /// Viz docs/business-decisions.md sekce 1.2.
  targetRoles     String?  @db.VarChar(255)
  orders          Order[]
  authorizedUsers User[]   @relation("AuthorizedCategories")
}

model Property {
  id             String              @id @default(cuid())
  name           String
  address        String?
  description    String?
  ownerId        String
  transferToken  String?             @unique
  transferStatus String?
  claimedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  orders         Order[]
  claimedBy      User?               @relation("PropertyClaimer", fields: [claimedById], references: [id])
  owner          User                @relation("PropertyOwner", fields: [ownerId], references: [id])
  transferFee    RealtorTransferFee? @relation("PropertyTransferFees")

  @@index([claimedById], map: "Property_claimedById_fkey")
  @@index([ownerId], map: "Property_ownerId_fkey")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  targetId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ActivityLog_userId_fkey")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  orderId     String
  text        String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "ChecklistItem_orderId_fkey")
}

model Message {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User     @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "Message_orderId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

model DefectTask {
  id          String   @id @default(cuid())
  orderId     String
  userId      String
  title       String
  description String?  @db.Text
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "DefectTask_orderId_fkey")
  @@index([userId], map: "DefectTask_userId_fkey")
}

model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  label     String?
  orderIds  String    @db.Text
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  customerId   String
  technicianId String
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now())
  customer     User     @relation("CustomerReviews", fields: [customerId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  technician   User     @relation("TechnicianReviews", fields: [technicianId], references: [id])

  @@index([customerId], map: "Review_customerId_fkey")
  @@index([technicianId], map: "Review_technicianId_fkey")
}

model OrderPhoto {
  id         String   @id @default(cuid())
  orderId    String
  imageData  String   @db.LongText
  caption    String?
  uploadedBy String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "OrderPhoto_orderId_fkey")
}

/// Idempotence Stripe webhooků (event.id = evt_…).
model StripeWebhookEvent {
  id        String   @id @db.VarChar(255)
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String   @default("GENERAL")
  status    String   @default("SENT")
  messageId String?
  error     String?  @db.Text
  orderId   String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([to])
  @@index([type])
  @@index([createdAt])
}

/// Žádost o výplatu od technika (Ticket pro výplatu)
model PayoutRequest {
  id           String    @id @default(cuid())
  technicianId String
  technician   User      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  amount       Float
  status       String    @default("PENDING") /// PENDING, PROCESSING, PAID, REJECTED
  requestedAt  DateTime  @default(now())
  paidAt       DateTime?
  notes        String?   @db.Text
  iban         String?
  invoiceUrl   String?   @db.LongText
  amountPaid   Float?
  dueDate      DateTime?
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([technicianId])
  @@index([orderId])
}

/// Tiket na support
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject   String   @db.VarChar(255)
  category  String   @default("GENERAL")
  status    String   @default("OPEN") /// OPEN, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
}

/// Zprava v tiketu na support
model SupportTicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User          @relation("UserSupportMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text          String?       @db.Text
  attachmentUrl String?       @db.LongText
  fileName      String?       @db.VarChar(255)
  createdAt     DateTime      @default(now())

  @@index([ticketId])
  @@index([senderId])
}
